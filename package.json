{
  "name": "home-cinema-player",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "test": "vitest run"
  },
  "dependencies": {
    "@noriginmedia/norigin-spatial-navigation": "^3.1.0",
    "adm-zip": "^0.5.17",
    "electron-store": "^8.2.0",
    "ffmpeg-static": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vitest": "^4.1.8",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.family.cinema-player",
    "productName": "Home Cinema Player",
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "assets/ffmpeg.exe"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
